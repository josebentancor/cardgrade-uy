# Copiar a .env y completar. NUNCA subir .env a un repositorio.

NODE_ENV=production
PORT=3000
# URL pública del sitio (con https). Se usa para las URLs de retorno y el webhook de Mercado Pago.
BASE_URL=https://cardgradeuy.com

# Mercado Pago (Tus integraciones > Credenciales de producción)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Tus integraciones > Webhooks > "Clave secreta" (para verificar la firma x-signature)
MP_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Sólo para desarrollo local sin credenciales: simula el pago. Se ignora en producción.
DEMO_PAYMENTS=0

# Carpeta donde se guardan la base de datos y las fotos subidas (fuera de public/)
DATA_DIR=./data
